# --- LLM provider -----------------------------------------------------------
# "groq" (default, free tier) or "openai". Exactly one model tool is exposed
# either way: Groq `browser_search` or OpenAI `web_search`.
LLM_PROVIDER=groq

# Required when LLM_PROVIDER=groq. Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Must be a Groq model that supports the built-in browser_search tool.
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high
GROQ_REASONING_EFFORT=medium

# Required only when LLM_PROVIDER=openai. https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- Optional ---------------------------------------------------------------
# SQLite file location (default: ./data/minimi.db)
MINIMI_DB_PATH=
# Per-turn hard timeout in ms (default 120000)
AGENT_TIMEOUT_MS=
