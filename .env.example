# --- Required ---------------------------------------------------------------
# Groq: the LLM (free tier, no card). Get a key: https://console.groq.com/keys
GROQ_API_KEY=
# Tavily: implementation of the agent's single web_search tool
# (free plan: 1,000 credits/month, no card). Get a key: https://app.tavily.com
TAVILY_API_KEY=

# --- Optional ---------------------------------------------------------------
# Groq model; must support tool calling.
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high (change checks are raised to at least medium automatically)
GROQ_REASONING_EFFORT=low
# Tokens-per-minute limit used to pace requests (Groq free tier: 8000).
GROQ_TPM_LIMIT=8000
# Max Tavily search queries per answer (1 credit each). Default 6.
MAX_SEARCHES_PER_TURN=6
# Max full-page reads (Tavily Extract) per answer; 1 credit per 5 pages read. Default 3.
MAX_EXTRACTS_PER_TURN=3
# Monthly Tavily credits on your plan, and how many to keep for "has it changed?" checks.
TAVILY_MONTHLY_CREDITS=1000
TAVILY_RESERVE_CREDITS=100
# Timezone used when the browser does not send one.
DEFAULT_TIMEZONE=Asia/Kolkata
# Research-snapshot distillation: "heuristic" (default; no extra API calls) or
# "model" (one small extra LLM call per research turn).
MEMORY_DISTILL=heuristic
# SQLite file location (default: ./data/minimi.db)
MINIMI_DB_PATH=
# Per-turn hard timeout in ms (default 120000)
AGENT_TIMEOUT_MS=

# --- Identity (all optional) ------------------------------------------------
# With none of these set the app runs in LOCAL mode: single user, no sign-in
# screen, exactly as before. Sign-in (AUTH mode) turns on automatically once
# AUTH_SECRET *and* at least one provider (client id + secret) are present.
#
# Signs the session cookie and the OAuth handshake. Any long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Absolute site origin, used to build OAuth callback URLs. Optional; defaults to
# the request's own origin. Set it behind a proxy/tunnel, e.g. https://minimi.example
PUBLIC_BASE_URL=

# GitHub OAuth app (required for the "Continue with GitHub" button).
# Create at: GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#   Homepage URL:              http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client (optional "Continue with Google" button).
# Create at: https://console.cloud.google.com/apis/credentials → OAuth client ID → Web
#   Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Try demo (optional; on by default) -------------------------------------
# A throwaway, seeded workspace with its own strict budgets so a visitor can
# explore without spending the owner's free Groq/Tavily quotas.
DEMO_ENABLED=true
# How long a demo workspace lives before it is cleaned up. Default 24 (hours).
DEMO_TTL_HOURS=24
# Model turns allowed per demo workspace. Default 8.
DEMO_MAX_TURNS=8
# Tavily credits allowed per demo workspace. Default 15.
DEMO_MAX_CREDITS=15
# How long a cached answer for a guided demo prompt stays fresh. Default 240 (min).
DEMO_CACHE_TTL_MINUTES=240
# Demo workspaces a single IP may create, and the window counted over.
DEMO_RATE_LIMIT_MAX=5
DEMO_RATE_LIMIT_WINDOW_MINUTES=60
# Hard ceiling on demos created per window across ALL clients (protects free quotas).
DEMO_GLOBAL_MAX=30
# Only behind a reverse proxy you control: trust its X-Forwarded-For hop for
# client IPs. Leave false for local use (forwarding headers are then ignored).
TRUST_PROXY=false
