# --- LLM provider -----------------------------------------------------------
# "gemini" (default) or "openai". Exactly one model tool is exposed either way:
# Gemini `googleSearch` or OpenAI `web_search`.
LLM_PROVIDER=gemini

# Required when LLM_PROVIDER=gemini. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Must support the Google Search tool. Run `npm run models` to see which models
# your key can use and whether Search grounding is enabled for them.
GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated models tried when the primary is overloaded (503) or unavailable.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite

# Only if LLM_PROVIDER=openai. https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- Optional ---------------------------------------------------------------
# SQLite file location (default: ./data/minimi.db)
MINIMI_DB_PATH=
# Memory distillation: "heuristic" (default; no extra API calls — best on free
# tiers) or "model" (one small extra LLM call per research turn).
MEMORY_DISTILL=heuristic
# Per-turn hard timeout in ms (default 120000)
AGENT_TIMEOUT_MS=
