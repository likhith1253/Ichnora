# --- LLM provider -----------------------------------------------------------
# "gemini" (default, free tier), "groq" or "openai". Exactly one model tool is
# exposed either way: Gemini `googleSearch`, Groq `browser_search` or OpenAI `web_search`.
LLM_PROVIDER=gemini

# Required when LLM_PROVIDER=gemini. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free tier: Google Search grounding is available on the Gemini 2.5 Flash family.
GEMINI_MODEL=gemini-2.5-flash

# Only if LLM_PROVIDER=groq. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high  (change checks are raised to at least medium automatically)
GROQ_REASONING_EFFORT=low

# Only if LLM_PROVIDER=openai. https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- Optional ---------------------------------------------------------------
# SQLite file location (default: ./data/minimi.db)
MINIMI_DB_PATH=
# Memory distillation: "heuristic" (default; no extra API calls — best on free
# tiers) or "model" (one small extra LLM call per research turn).
MEMORY_DISTILL=heuristic
# Per-turn hard timeout in ms (default 120000)
AGENT_TIMEOUT_MS=
