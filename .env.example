# --- Required ---------------------------------------------------------------
# Groq: the LLM (free tier, no card). Get a key: https://console.groq.com/keys
GROQ_API_KEY=
# Tavily: implementation of the agent's single web_search tool
# (free plan: 1,000 credits/month, no card). Get a key: https://app.tavily.com
TAVILY_API_KEY=

# --- Optional ---------------------------------------------------------------
# Groq model; must support tool calling.
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high (change checks are raised to at least medium automatically)
GROQ_REASONING_EFFORT=low
# Tokens-per-minute limit used to pace requests (Groq free tier: 8000).
GROQ_TPM_LIMIT=8000
# Max Tavily search queries per answer (1 credit each). Default 6.
MAX_SEARCHES_PER_TURN=6
# Max full-page reads (Tavily Extract) per answer; 1 credit per 5 pages read. Default 3.
MAX_EXTRACTS_PER_TURN=3
# Monthly Tavily credits on your plan, and how many to keep for "has it changed?" checks.
TAVILY_MONTHLY_CREDITS=1000
TAVILY_RESERVE_CREDITS=100
# Timezone used when the browser does not send one.
DEFAULT_TIMEZONE=Asia/Kolkata
# Research-snapshot distillation: "heuristic" (default; no extra API calls) or
# "model" (one small extra LLM call per research turn).
MEMORY_DISTILL=heuristic
# SQLite file location (default: ./data/minimi.db)
MINIMI_DB_PATH=
# Per-turn hard timeout in ms (default 120000)
AGENT_TIMEOUT_MS=
